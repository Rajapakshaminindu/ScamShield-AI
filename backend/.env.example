# Alibaba Cloud Model Studio (DashScope) API Key
# Sign up at: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Alibaba Cloud DashScope Base URL (OpenAI-compatible)
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Qwen Model Name (e.g., qwen-plus, qwen-turbo, qwen-max, qwen-vl-plus)
QWEN_MODEL_NAME=qwen-plus

# Server Configuration
PORT=8000
HOST=0.0.0.0
