# OpenRouter API Key (free tier, OpenAI-compatible)
# Sign up at: https://openrouter.ai/keys
# Variable names are legacy but the client is OpenAI-compatible.
DASHSCOPE_API_KEY=your_openrouter_api_key_here

# OpenRouter Base URL
DASHSCOPE_BASE_URL=https://openrouter.ai/api/v1

# Fast free text model for scam analysis
QWEN_MODEL_NAME=liquid/lfm-2.5-2.6b:free

# Free vision model for screenshot analysis
QWEN_VL_MODEL_NAME=google/gemma-4-31b-it:free

# Server Configuration
PORT=8000
HOST=0.0.0.0

# JWT Secret (change this to a random string in production)
JWT_SECRET=change-me-to-a-random-secret-string

# Seeded admin account (defaults to admin / admin123 if omitted).
# Always set a strong password on a public deployment.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@scamshield.ai
ADMIN_PASSWORD=admin123
